# Сайт статический (output: "export"). Все переменные — NEXT_PUBLIC_*, они вшиваются
# в сборку: после изменения на Vercel нужен Redeploy. Секретов здесь быть не должно.
# Локально — в .env.local (в git не попадает).

# Адрес сайта: canonical, sitemap.xml, Open Graph. Без слэша в конце.
NEXT_PUBLIC_SITE_URL=https://stepline.kz

# Пока каталог демо — закрыть сайт от индексации (1 = закрыть). Перед запуском убрать.
NEXT_PUBLIC_NOINDEX=1

# Куда уходят заказы, запросы «На заказ» и ответы со страницы /design — письмом на почту.
# Ключ берётся на https://web3forms.com (вводите почту → ключ приходит письмом).
# Ключ публичный по замыслу сервиса: он только разрешает слать письма на эту почту.
# Без ключа формы не ломаются — предлагают отправить в WhatsApp или скачать JSON.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Подпапка сайта на GitHub Pages (/stepline-floors). Ставит workflow сам; локально — пусто.
NEXT_PUBLIC_BASE_PATH=

# Аналитика: грузится только после «Принять все» в баннере cookies
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=
